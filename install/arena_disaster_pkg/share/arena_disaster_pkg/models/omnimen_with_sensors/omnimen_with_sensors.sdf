<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="omnimen_with_sensors">
    <!-- Включаем оригинальный URDF робота -->
    <include>
      <uri>model://omnimen</uri>
      <name>omnimen_base</name>
      <pose>0 0 0 0 0 0</pose>
    </include>

    <!-- Лидар -->
    <link name="lidar_sensor_link">
      <pose>0 0 0.3 0 0 0</pose>
      <sensor name="omnimen_lidar" type="lidar">
        <always_on>true</always_on>
        <update_rate>10</update_rate>
        <visualize>true</visualize>
        <lidar>
          <scan>
            <horizontal>
              <samples>360</samples>
              <resolution>1.0</resolution>
              <min_angle>-3.14159</min_angle>
              <max_angle>3.14159</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.1</min>
            <max>10.0</max>
            <resolution>0.01</resolution>
          </range>
        </lidar>
        <topic>/model/omnimen/scan</topic>
      </sensor>
    </link>

    <!-- Камера -->
    <link name="camera_sensor_link">
      <pose>0.1 0 0.2 0 0 0</pose>
      <sensor name="omnimen_camera" type="camera">
        <always_on>true</always_on>
        <update_rate>15</update_rate>
        <camera name="camera">
          <horizontal_fov>1.047</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>20.0</far>
          </clip>
        </camera>
        <topic>/model/omnimen/camera/image_raw</topic>
      </sensor>
    </link>

    <!-- Плагин для публикации состояний суставов -->
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"/>
  </model>
</sdf>
