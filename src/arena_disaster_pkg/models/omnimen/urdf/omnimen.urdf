      <lidar>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1.0</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.1</min>
          <max>10.0</max>
          <resolution>0.01</resolution>
        </range>
      </lidar>
      <topic>/model/omnimen/scan</topic>
    </sensor>
  </gazebo>
  <gazebo reference="kamera_1__Твердое_тело1">
    <sensor name="omnimen_camera" type="camera">
      <always_on>true</always_on>
      <update_rate>15</update_rate>
      <always_on>true</always_on>
      <pose>0 0 0 0 0 0</pose>
      <update_rate>15.0</update_rate>
      <camera name="camera">
        <horizontal_fov>1.047</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.05</near>
          <far>20.0</far>
        </clip>
      </camera>
      <topic>/model/omnimen/camera/image_raw</topic>
    </sensor>
  </gazebo>
  
  



<gazebo>
